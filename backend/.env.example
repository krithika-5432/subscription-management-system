PORT=5000

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/subscription_management

# Use a long random value. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Leave EMAIL_HOST empty in development: emails are then written to the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Brightloop <no-reply@brightloop.in>

# Optional. Enables "Continue with Google" (must match VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID= 

# Set to false to stop the in-process billing scheduler.
ENABLE_SCHEDULER=true

# Login attempts per IP per 15 minutes (default 30). Raise it only while running the test suite.
# AUTH_RATE_LIMIT=1000
